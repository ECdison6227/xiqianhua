{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "esModuleInterop": true,
    "skipLibCheck": true, "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"], "allowImportingTsExtensions": true
  },
  "include": ["src", "shared", "server", "tests", "scripts", "vite.config.ts"]
}
